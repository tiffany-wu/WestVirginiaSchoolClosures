ui <- fluidPage(
titlePanel("West Virginia Enrollment Consolidation Explorer"),
sidebarLayout(
sidebarPanel(
width = 3,
selectInput(
"district_filter",
"District",
choices = c("All", sort(unique(school_status$District))),
selected = "All",
multiple = TRUE
),
selectInput(
"school_type_filter",
"School type",
choices = c("All", sort(unique(school_status$Type))),
selected = "All",
multiple = TRUE
),
selectInput(
"closure_filter",
"Closure status",
choices = c("All", "Closed", "Open"),
selected = "All"
),
selectInput(
"flipped_filter",
"Flipped status",
choices = c("All", "Flipped", "Not flipped"),
selected = "All"
),
sliderInput(
"year_range",
"Year range",
min = min(district_panel$Year, na.rm = TRUE),
max = max(district_panel$Year, na.rm = TRUE),
value = c(
min(district_panel$Year, na.rm = TRUE),
max(district_panel$Year, na.rm = TRUE)
),
step = 1,
sep = ""
)
),
mainPanel(
tabsetPanel(
tabPanel(
"Descriptives",
DTOutput("desc_table")
),
tabPanel(
"Enrollment Trends: Consolidation Year",
plotOutput("did_plot_1", height = "1400px")
),
tabPanel(
"Enrollment Trends: Year Before",
plotOutput("did_plot_2", height = "1400px")
),
tabPanel(
"Enrollment Change Map",
leafletOutput("enrollment_map", height = "700px")
),
tabPanel(
"Schools Closed by Year Maps",
plotOutput("year_maps_grid", height = "1400px")
)
)
)
)
)
# =========================
# 5. SERVER
# =========================
server <- function(input, output, session) {
filtered_school_status <- reactive({
df <- school_status
if (!is.null(input$district_filter) && !("All" %in% input$district_filter)) {
df <- df %>% filter(District %in% input$district_filter)
}
if (!is.null(input$school_type_filter) && !("All" %in% input$school_type_filter)) {
df <- df %>% filter(Type %in% input$school_type_filter)
}
if (input$closure_filter == "Closed") {
df <- df %>% filter(closed)
} else if (input$closure_filter == "Open") {
df <- df %>% filter(!closed)
}
if (input$flipped_filter == "Flipped") {
df <- df %>% filter(flipped)
} else if (input$flipped_filter == "Not flipped") {
df <- df %>% filter(!flipped)
}
df
})
filtered_district_panel <- reactive({
keep_districts <- filtered_school_status() %>%
distinct(District) %>%
pull(District)
district_panel %>%
filter(
District %in% keep_districts,
Year >= input$year_range[1],
Year <= input$year_range[2]
)
})
filtered_map_sf <- reactive({
keep_districts <- filtered_school_status() %>%
distinct(District) %>%
pull(District)
df <- district_map_sf %>%
filter(District %in% keep_districts)
validate(need(nrow(df) > 0, "No districts match the current filters."))
df
})
filtered_school_comp <- reactive({
keep_districts <- filtered_school_status() %>%
distinct(District) %>%
pull(District)
school_comp_clean %>%
filter(
District %in% keep_districts,
Year >= input$year_range[1],
Year <= input$year_range[2]
)
})
output$desc_table <- renderDT({
desc_df <- filtered_school_comp() %>%
group_by(Year, District) %>%
summarise(
total_headcount = sum(headcount, na.rm = TRUE),
n_schools = n_distinct(School),
.groups = "drop"
) %>%
left_join(
filtered_school_status() %>%
group_by(District) %>%
summarise(
any_closed = any(closed, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
district_status = ifelse(any_closed, "Has closed school(s)", "All open")
) %>%
select(-any_closed),
by = "District"
) %>%
arrange(District, Year)
DT::datatable(
desc_df,
rownames = FALSE,
options = list(
pageLength = 25,
scrollX = TRUE
)
)
})
plot_data_cons <- reactive({
build_pre_post_plot_data(filtered_district_panel(), offset = 0)
})
plot_data_pre <- reactive({
build_pre_post_plot_data(filtered_district_panel(), offset = -1)
})
output$did_plot_1 <- renderPlot({
df <- plot_data_cons()
req(nrow(df) > 0)
vlines <- df %>%
distinct(facet_label, threshold)
ggplot(df, aes(x = Year, y = enrollment, color = period, group = 1)) +
geom_line(linewidth = 0.7) +
geom_point(size = 1.8) +
geom_vline(
data = vlines,
aes(xintercept = threshold + 0.5),
inherit.aes = FALSE,
linetype = "dashed",
color = "gray50",
linewidth = 0.4
) +
facet_wrap(~facet_label, ncol = 5, scales = "free_y") +
scale_color_manual(values = c("pre" = "#2b6cb0", "post" = "#c53030")) +
labs(
title = "Pre/post enrollment (threshold = first consolidation year)",
x = NULL,
y = "Enrollment",
color = NULL
) +
theme_minimal(base_size = 10) +
theme(
legend.position = "top",
strip.text = element_text(size = 8),
axis.text = element_text(size = 7),
axis.title.y = element_text(size = 10)
)
})
output$did_plot_2 <- renderPlot({
df <- plot_data_pre()
req(nrow(df) > 0)
vlines <- df %>%
distinct(facet_label, threshold)
ggplot(df, aes(x = Year, y = enrollment, color = period, group = 1)) +
geom_line(linewidth = 0.7) +
geom_point(size = 1.8) +
geom_vline(
data = vlines,
aes(xintercept = threshold + 0.5),
inherit.aes = FALSE,
linetype = "dashed",
color = "gray50",
linewidth = 0.4
) +
facet_wrap(~facet_label, ncol = 5, scales = "free_y") +
scale_color_manual(values = c("pre" = "#2b6cb0", "post" = "#c53030")) +
labs(
title = "Pre/post enrollment (threshold = one year before first consolidation)",
x = NULL,
y = "Enrollment",
color = NULL
) +
theme_minimal(base_size = 10) +
theme(
legend.position = "top",
strip.text = element_text(size = 8),
axis.text = element_text(size = 7),
axis.title.y = element_text(size = 10)
)
})
output$enrollment_map <- renderLeaflet({
df <- filtered_map_sf()
pal <- leaflet::colorNumeric(
palette = "RdBu",
domain = df$pct_change,
reverse = FALSE,
na.color = "#d9d9d9"
)
leaflet(df) %>%
addTiles() %>%
addPolygons(
fillColor = ~pal(pct_change),
fillOpacity = 0.8,
color = "#444444",
weight = 1,
label = lapply(df$label_html, htmltools::HTML),
labelOptions = labelOptions(
direction = "auto",
textsize = "13px",
style = list(
"font-weight" = "normal",
padding = "6px 8px"
)
),
highlightOptions = highlightOptions(
weight = 2,
color = "#222222",
bringToFront = TRUE
)
) %>%
addLegend(
position = "bottomright",
pal = pal,
values = ~pct_change,
title = "% enrollment change"
)
})
year_maps_sf <- reactive({
keep_districts <- filtered_school_status() %>%
distinct(District) %>%
pull(District)
shape_df <- district_shapes %>%
mutate(
District = stringr::str_remove(NAME, " County School District$| County Schools$| Schools$| School District$"),
District = stringr::str_squish(District)
)
panel_df <- district_panel %>%
filter(
District %in% keep_districts,
Year >= input$year_range[1],
Year <= input$year_range[2]
) %>%
select(District, Year, enrollment)
out <- shape_df %>%
left_join(panel_df, by = "District") %>%
filter(!is.na(Year))
validate(need(nrow(out) > 0, "No districts/years match the current filters."))
out
})
output$year_maps_grid <- renderPlot({
keep_districts <- filtered_school_status() %>%
distinct(District) %>%
pull(District)
closure_map_df <- build_closure_year_map_data(
school_status = filtered_school_status(),
district_shapes = district_shapes,
year_min = input$year_range[1],
year_max = input$year_range[2]
) %>%
filter(District %in% keep_districts)
req(nrow(closure_map_df) > 0)
closure_map_df$Year <- factor(closure_map_df$Year)
ggplot(closure_map_df) +
geom_sf(aes(fill = n_closed_that_year), color = "gray50", linewidth = 0.15) +
facet_wrap(~Year, ncol = 5) +
scale_fill_gradient(
low = "#f7fbff",
high = "red3",
na.value = "#d9d9d9"
) +
labs(
title = "Number of Schools Closed Within Each District by Year",
fill = "# Closed"
) +
theme_void() +
theme(
strip.text = element_text(size = 9),
plot.title = element_text(size = 12, hjust = 0.5),
legend.position = "bottom"
)
})
}
dir.create("www/map_files", recursive = TRUE, showWarnings = FALSE)
htmlwidgets::saveWidget(
m2,
"www/map_files/enrollment_change_map.html",
selfcontained = FALSE
)
pal <- leaflet::colorNumeric(
palette = "RdBu",
domain = district_map_sf$pct_change,
reverse = FALSE,
na.color = "#d9d9d9"
)
m2 <- leaflet::leaflet(district_map_sf) %>%
leaflet::addProviderTiles("CartoDB.Positron") %>%
leaflet::addPolygons(
fillColor = ~pal(pct_change),
fillOpacity = 0.8,
color = "#444444",
weight = 1,
label = lapply(
paste0(
"<strong>", district_map_sf$District, "</strong>",
"<br>Percent change: ", round(district_map_sf$pct_change, 1), "%",
"<br>Total change: ", scales::comma(district_map_sf$total_change),
"<br>Closed schools: ", district_map_sf$n_closed
),
htmltools::HTML
),
labelOptions = leaflet::labelOptions(
direction = "auto",
textsize = "13px",
style = list(
"font-weight" = "normal",
padding = "6px 8px"
)
),
highlightOptions = leaflet::highlightOptions(
weight = 2,
color = "#222222",
bringToFront = TRUE
)
) %>%
leaflet::addLegend(
position = "bottomright",
pal = pal,
values = ~pct_change,
title = "% enrollment change"
)
dir.create("www/map_files", recursive = TRUE, showWarnings = FALSE)
htmlwidgets::saveWidget(
m2,
"www/map_files/enrollment_change_map.html",
selfcontained = FALSE
)
